.detail-page {
  padding: 20rpx;
}

.detail-card {
  margin-bottom: 20rpx;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
  line-height: 1.4;
}

.detail-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.row-label {
  font-size: 26rpx;
  color: #999;
  width: 140rpx;
}

.row-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.detail-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}
