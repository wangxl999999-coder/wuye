.announcements-page {
  padding: 20rpx;
}

.list-container {
  padding-bottom: 40rpx;
}

.announcement-item {
  margin-bottom: 20rpx;
}

.announcement-header {
  margin-bottom: 16rpx;
}

.announcement-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
}

.announcement-title .tag {
  margin-right: 12rpx;
}

.announcement-time {
  font-size: 24rpx;
  color: #999;
}

.announcement-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-text {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 28rpx;
}
