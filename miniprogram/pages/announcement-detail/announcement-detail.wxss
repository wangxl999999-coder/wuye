.detail-page {
  padding: 20rpx;
}

.detail-header {
  margin-bottom: 20rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.detail-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.detail-time,
.detail-author {
  font-size: 24rpx;
  color: #999;
}

.detail-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}
