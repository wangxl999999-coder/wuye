.index-page {
  padding-bottom: 40rpx;
}

.user-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 0 20rpx 20rpx;
  padding: 40rpx;
  border-radius: 16rpx;
  color: white;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

.user-detail {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-tip {
  font-size: 26rpx;
  opacity: 0.9;
}

.user-room {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.login-btn {
  background: white;
  color: #667eea;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.quick-actions {
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.icon-text {
  font-size: 36rpx;
  font-weight: bold;
}

.action-name {
  font-size: 26rpx;
  color: #333;
}

.section {
  margin: 0 20rpx 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #999;
}

.announcement-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.announcement-item:last-child {
  border-bottom: none;
}

.announcement-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
}

.announcement-title .tag {
  margin-right: 12rpx;
}

.announcement-time {
  font-size: 24rpx;
  color: #999;
}

.event-list {
  margin-top: 20rpx;
}

.event-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
}

.event-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #F56C6C;
  margin-top: 8rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.event-content {
  flex: 1;
}

.event-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.event-desc {
  font-size: 24rpx;
  color: #999;
}

.empty-text {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}
