.activities-page {
  padding: 20rpx;
}

.list-container {
  padding-bottom: 40rpx;
}

.activity-item {
  margin-bottom: 20rpx;
  overflow: hidden;
}

.activity-banner {
  margin: -24rpx -24rpx 24rpx;
}

.activity-banner-placeholder {
  height: 200rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-icon {
  font-size: 80rpx;
}

.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.activity-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.activity-info {
  margin-bottom: 16rpx;
}

.info-item {
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
}

.activity-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.empty-text {
  text-align: center;
  padding: 80rpx;
  color: #999;
  font-size: 28rpx;
}
