<view class="activities-page">
  <view class="list-container">
    <view class="activity-item card" wx:for="{{activities}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="activity-banner">
        <view class="activity-banner-placeholder">
          <text class="banner-icon">🎉</text>
        </view>
      </view>
      <view class="activity-content">
        <view class="activity-header">
          <view class="activity-title">{{item.title}}</view>
          <text class="tag {{getStatusClass(item.status)}}">{{getStatusText(item.status)}}</text>
        </view>
        <view class="activity-info">
          <view class="info-item">
            <text class="info-label">时间：</text>
            <text class="info-value">{{item.start_time}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">地点：</text>
            <text class="info-value">{{item.location || '待定'}}</text>
          </view>
        </view>
        <view class="activity-desc">{{item.description}}</view>
      </view>
    </view>

    <view class="empty-text" wx:if="{{activities.length === 0}}">
      暂无活动
    </view>
  </view>
</view>
